# Backend (local dev: `npm run dev` in backend/, which reads backend/.env)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public origin where the app is served. docker compose: http://localhost
# (prod: https://your-domain.com, dev: http://localhost:5173)
BETTER_AUTH_URL=http://localhost

# Comma-separated list of allowed frontend origins for CORS.
# Empty means deny-all cross-origin (same-origin via Caddy unaffected).
CORS_ORIGINS=http://localhost:5173

# Request log verbosity (default: info). Use debug to inspect requests.
#LOG_LEVEL=info

# Set to 'false' to hide /api/docs and /api/openapi.json (forced off is
# automatic in production unless explicitly enabled).
#DOCS_ENABLED=true

# Auth emails (Resend). Dev can use Resend's test sender address;
# production needs a verified sending domain (SPF/DKIM in DNS).
RESEND_API_KEY=re_xxx
EMAIL_FROM=Cover Voice <noreply@example.com>

# Postgres (used by docker compose to build the backend DATABASE_URL;
# DATABASE_URL above is only for local dev outside compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Public origin / domain. compose.yaml wires this into the frontend ORIGIN
# (required for CSRF/cookies/redirects) and the Caddy site address
# (automatic TLS when this is an https:// domain).
DOMAIN=http://localhost

# Name for `docker compose -p` on the prod host (see deploy-prod.yml).
#COMPOSE_PROJECT_NAME=cover-voice

# for verification emails
RESEND_API_KEY=example_api_key
