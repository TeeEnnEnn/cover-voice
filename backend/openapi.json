  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "Block": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "name": {
            "type": "string",
            "example": "test"
          },
          "value": {
            "type": "string",
            "example": "some value"
          },
          "userId": {
            "type": "string",
            "example": "abc123"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-13T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-13T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "value",
          "userId",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBlockBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "greeting"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "example": "Hello my name is ${..."
          }
        },
        "required": [
          "name",
          "value"
        ]
      },
      "UpdateBlockBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "test"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "example": "some value"
          }
        }
      },
      "BlockList": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          }
        },
        "required": [
          "blocks"
        ]
      },
      "Variable": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
